# OpenRouter API Key (for GPT-4o, Claude, Llama, etc.)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Google Generative AI API Key (for Gemini models via AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key-here

# ── Google Cloud Vertex AI (for Gemini billed via GCP, e.g. $300 free trial) ─
# Required when using `google-vertex` baseProvider.
# Service Account JSON — paste the *raw JSON content* (Docker-friendly).
# Tip: compact it with `jq -c . sa.json` to fit on one line.
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# Alternative: path to SA JSON file (mount it into the container).
# GOOGLE_VERTEX_CREDENTIALS_FILE=/run/secrets/vertex-sa.json
#
# Optional overrides (defaults: project_id from SA JSON, location "us-central1")
# GOOGLE_VERTEX_PROJECT=my-gcp-project
# GOOGLE_VERTEX_LOCATION=us-central1

# ── Local LLM configuration ──────────────────────────────────────────
# The app calls Chat Completions via `${baseURL}/chat/completions`.
#
# Option A: Single endpoint (llama.cpp with internal model routing)
LOCAL_LLM_URL=http://192.168.88.127:8080/v1
#
# Option B: Per-model endpoints (ik_llama.cpp or multiple instances)
# JSON map: keys are model IDs from data/models.json, values are base URLs.
# Models not listed here fall back to LOCAL_LLM_URL.
# LOCAL_LLM_HOSTS={"qwen3.5-122b-a10b":"http://192.168.88.127:8080/v1","qwen3.5-35b-a3b":"http://192.168.88.127:8081/v1"}

# JWT Secret for session management (generate a random 32+ char string)
JWT_SECRET=change-me-to-a-random-secret-string-at-least-32-chars

# Default admin password on first run
ADMIN_INIT_PASS=admin123

# ── Mail (sign-in by email code, password recovery) ───────────────────
# Without SMTP_URL and MAIL_FROM a development server prints mail (codes
# included) to its log; a production server offers password sign-in only.
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=FaMeowly <noreply@example.com>
# Secret for login code hashes; defaults to JWT_SECRET
# AUTH_CODE_SECRET=
# Number of reverse proxies appending to X-Forwarded-For. Enables per-IP
# sign-in limits; 0 or unset = off (use it when the client IP is not known).
# TRUSTED_PROXY_HOPS=1

# ── Chat UI ──────────────────────────────────────────────────────────────
# Emoji on the answer-option chips above the input: on by default, `false` hides them.
# Emoji next to each choice in their lists: off by default, `true` shows them.
# Both are read at request time.
# CHAT_OPTION_ICONS=false
# CHAT_OPTION_LIST_ICONS=true

# ── Web search (SearXNG) ──────────────────────────────────────────────
# Self-hosted metasearch used for live web search. Started by docker-compose
# as the `searxng` service; leave unset to disable web search entirely.
# In Docker: http://searxng:8080
# Local dev: http://127.0.0.1:8888
SEARXNG_URL=
# Any random string; the container refuses to start with the default.
SEARXNG_SECRET=

# ── Company details (public /requisites page) ───────────────────────────
# Payment providers require them on the site. The page and the link on the
# login screen appear only when NAME, INN and OGRN are all set.
# A 15-digit OGRN is shown as ОГРНИП (sole proprietor).
COMPANY_NAME=
COMPANY_INN=
COMPANY_OGRN=
# Optional
# COMPANY_KPP=
# COMPANY_ADDRESS=
# COMPANY_EMAIL=
# COMPANY_PHONE=

# ── T-Bank acquiring (premium `payments` plugin) ─────────────────────
# Terminal key and password from the T-Bank merchant cabinet (Магазины →
# Терминалы). A demo terminal key ends with "DEMO". Payment buttons answer
# "Оплата пока не настроена" until all three are set.
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# Public origin used for SuccessURL / FailURL / NotificationURL, no trailing slash
# PUBLIC_SITE_URL=https://fameowly.ru
# Optional, defaults to https://securepay.tinkoff.ru/v2
# TBANK_API_URL=
#
# 54-FZ receipts. Set these only together with enabling the online cash
# register on the terminal: the bank rejects payments when the two disagree.
# Taxation: osn | usn_income | usn_income_outcome | esn | patent
# TBANK_TAXATION=usn_income
# VAT tag, default "none" (USN under the VAT threshold) — ask your accountant
# TBANK_VAT=none
# Receipt format version configured for the cash register: 1.05 (default) or 1.2
# TBANK_FFD_VERSION=1.2

# ── MongoDB storage (premium `storage-mongo` plugin) ────────────────
# When set, every document collection lives in MongoDB instead of DATA_DIR/db.
# Needs a replica set (a single node is enough); include the database name.
# MONGODB_URI=mongodb://mongo:27017/fameowly?replicaSet=rs0
